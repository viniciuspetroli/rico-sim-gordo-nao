# ===== Melhor Envio =====
# Cliente OAuth criado no painel do ME (Configurações > Tokens > Aplicações)
ME_CLIENT_ID=
ME_CLIENT_SECRET=
# "sandbox" ou "production" — controla qual ambiente do ME usar
ME_ENV=sandbox
# Email obrigatório no User-Agent das requests do ME
ME_CONTACT_EMAIL=guerraagencia@gmail.com

# ===== Stripe =====
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ===== Upstash Redis (auto-preenchido pela integração do Vercel) =====
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Supabase (banco de pedidos / painel) =====
SUPABASE_URL=https://ghxhbrvvpzlkuzcahajk.supabase.co
# service_role key — acesso total, SÓ no servidor. Pegar em Settings > API.
SUPABASE_SERVICE_ROLE_KEY=
# anon key — pública, ok expor
SUPABASE_ANON_KEY=

# ===== Painel admin =====
# Senha de acesso ao painel (/admin). Compartilhada entre você e o João.
ADMIN_PASSWORD=

# ===== Cron (refresh automático do token do ME) =====
# String aleatória. O Vercel envia como Authorization: Bearer <CRON_SECRET>
# nas execuções do cron, e o endpoint valida.
CRON_SECRET=

# ===== Webhooks do n8n =====
# Recebe os erros de geração de etiqueta (já configurado)
N8N_ERROR_WEBHOOK=https://n8n.impacta.click/webhook/email-erro-bone-guerra
# Recebe inscrições da waitlist (cadastrar no n8n e colar URL aqui)
N8N_WAITLIST_WEBHOOK=
